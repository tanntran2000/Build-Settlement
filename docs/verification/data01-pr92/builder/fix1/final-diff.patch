+  expect(startup.record.mock.calls).toEqual([['RUNTIME', 'UNCAUGHT_ERROR'], ['RUNTIME', 'UNHANDLED_REJECTION']]);
+  expect(startup.flush).toHaveBeenCalledOnce();
+});
