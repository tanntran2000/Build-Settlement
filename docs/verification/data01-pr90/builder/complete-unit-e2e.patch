+// Raw-observable GameStore double: verifies service clears the entire slot; A3 checks real IndexedDB tables.
+function inspectableDeps() {
+ let rows: StoredRecord[] = [];
+ const store: GameStore = {
+  read: vi.fn(async (slotId: string) => {const found=rows.filter(r=>r.slotId===slotId&&r.table!=='system');return found.some(r=>r.table==='meta')?structuredClone(found):null;}),
+  replaceSlot: vi.fn(async (slotId: string,next: StoredRecord[],extra: StoredRecord[] = []) => {rows=rows.filter(r=>r.slotId!==slotId&& !extra.some(e=>e.slotId===r.slotId&&e.table===r.table&&e.id===r.id));rows.push(...structuredClone([...next,...extra]));return {put:next.length,deleted:0,unchanged:0};}),
+  clear: vi.fn(async (slotId: string) => {rows=rows.filter(r=>r.slotId!==slotId||r.table==='system');}),
+  getSystem: vi.fn(async (id: string) => rows.find(r=>r.table==='system'&&r.id===id)??null)
+ };
+ const values=new Map<string,string>();const legacy={getItem:vi.fn((key:string)=>values.get(key)??null),removeItem:vi.fn((key:string)=>{values.delete(key);})};
+ return {store,legacy,values,rows:()=>structuredClone(rows)};
+}
