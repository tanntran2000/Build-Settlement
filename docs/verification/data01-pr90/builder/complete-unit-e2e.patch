+it('migrates legacy once and never touches legacy on second read', async () => { const d = deps(a2Text()); vi.spyOn(d.store,'read'); expect(await readLocalCharacterLife(d)).toEqual({ success: true,state: a2Session() }); expect(d.store.read).toHaveBeenCalledExactlyOnceWith('main'); expect(await d.store.getSystem(MARKER)).not.toBeNull(); expect(await readLocalCharacterLife(d)).toEqual({ success: true,state: a2Session() }); expect(d.legacy.getItem).toHaveBeenCalledTimes(1); expect(d.legacy.removeItem).not.toHaveBeenCalled(); });
+it('empty legacy writes marker', async () => { const d = deps(); expect(await readLocalCharacterLife(d)).toEqual({ success: false,message: NONE }); expect(await d.store.getSystem(MARKER)).not.toBeNull(); });
