+const a2Session = () => { const r = createCharacterLifeSession(0, { ...structuredClone(DEFAULT_PLAYER_DRAFT),currentName: 'Ana' }); if (!r.success) throw Error(r.error.message); return r.value; };
+const a2Text = () => { const r = serializeCharacterLifeSave(a2Session()); if (!r.success) throw Error(r.error.message); return r.text; };
+function deps(initial: string | null = null, opts = { failWrites: false }) {
+  let value = initial;
+  return { store: createMemoryGameStore(opts), legacy: { getItem: vi.fn(() => value),removeItem: vi.fn(() => { value = null; }) } };
+}
